# Copy to .env and fill in real values. .env is gitignored.

# PostgreSQL connection (async driver). Matches docker-compose.yml default.
DATABASE_URL=postgresql+asyncpg://hercules:hercules@localhost:5432/hercules

# USDA FoodData Central API key. Get one free at https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=replace-me

# HTTP server
HOST=0.0.0.0
PORT=8000

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
